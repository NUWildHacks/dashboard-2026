rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data != null ? userDoc.data.role : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'Admin';
    }

    function userOwnsDocument(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Authenticated users can read user documents (needed for team members queries)
      allow read: if isAuthenticated();

      // Users can create their own document (during registration via server action)
      // Note: Server actions use Admin SDK, but we keep this for defense in depth
      // Security: Prevent users from setting Admin role on create - only PARTICIPANT, JUDGE, or MENTOR allowed
      // Admin role can only be set via Admin SDK (server actions)
      allow create: if isAuthenticated()
        && userOwnsDocument(userId)
        && (!('role' in request.resource.data) || request.resource.data.role != 'Admin');

      // Users can update their own document (except role field)
      // Role can only be modified by admins
      allow update: if isAuthenticated() && userOwnsDocument(userId) && (request.resource.data.role == resource.data.role || isAdmin());

      // Users can delete their own document (withdraw from event) or admins can delete any
      allow delete: if isAuthenticated() && (userOwnsDocument(userId) || isAdmin());
    }

    // Projects collection
    match /projects/{projectId} {
      // Authenticated users can read project documents (needed for judging)
      // Note: Create, update, and delete operations are handled via server actions using Admin SDK
      allow read: if isAuthenticated();
    }

    // Events collection
    match /events/{eventId} {
      // All authenticated users can read events
      allow read: if isAuthenticated();

      // Only admins can create, update, or delete events
      // Note: Server actions use Admin SDK, but we keep this for defense in depth
      allow write: if isAdmin();
    }

    // WildHacks collection (config document)
    match /wildhacks/{document=**} {
      // All authenticated users can read config
      allow read: if isAuthenticated();

      // Only admins can write to config
      // Note: Server actions use Admin SDK, but we keep this for defense in depth
      allow write: if isAdmin();
    }

    // Permission codes collection
    match /permission_codes/{document=**} {
      // Only admins can read, create, update, and delete permission codes
      // Note: Server actions use Admin SDK, but we keep this for defense in depth
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}

